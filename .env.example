# =============================================================
# Bee Moore Advisory — environment variables
#
# Copy to .env.local for local dev (vercel dev), and add the same
# keys in Vercel: Settings -> Environment Variables.
# NEVER commit real keys. .env.local is gitignored.
# =============================================================

# Required. From https://resend.com -> API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Where enquiries are delivered.
CONTACT_TO=bayo.olawunmi@gmail.com

# Optional. The "from" address.
#
# BEFORE you verify beemooreadvisory.com in Resend, use the sandbox
# sender below. Note it can ONLY deliver to the address you signed up
# to Resend with:
#   CONTACT_FROM=Bee Moore Advisory <onboarding@resend.dev>
#
# AFTER verifying the domain in Resend (Domains -> Add Domain, then add
# the DNS records at Squarespace), switch to your own address:
CONTACT_FROM=Bee Moore Advisory <hello@beemooreadvisory.com>
