{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(css|js|assets)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800, must-revalidate" }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=300, must-revalidate" }
      ]
    }
  ],
  "redirects": [
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/reports.html", "destination": "/resources.html", "permanent": true },
    { "source": "/reports", "destination": "/resources.html", "permanent": true },
    { "source": "/deals", "destination": "/deal-room.html", "permanent": true },
    { "source": "/deal-room", "destination": "/deal-room.html", "permanent": true },
    { "source": "/about-the-principal", "destination": "/about.html", "permanent": true },
    { "source": "/founder", "destination": "/about.html", "permanent": true },
    { "source": "/cv", "destination": "/assets/documents/adebayo-olawunmi-cv.pdf", "permanent": false },
    { "source": "/whatsapp", "destination": "https://wa.me/2349015006151", "permanent": false },
    { "source": "/newsletter", "destination": "https://substack.com/@naijainteldesk", "permanent": false }
  ]
}
